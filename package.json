{
  "name": "instascope",
  "version": "0.1.0",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "ng": "ng",
    "start": "node --env-file-if-exists=.env scripts/write-public-config.mjs && ng serve",
    "build": "node --env-file-if-exists=.env scripts/write-public-config.mjs && ng build --configuration production && node --env-file-if-exists=.env scripts/generate-seo.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "ng build --configuration development",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "serve:static": "node scripts/serve-static.mjs",
    "screenshots:demo": "corepack pnpm run build && node scripts/capture-demo-screenshots.mjs",
    "audit": "pnpm audit --audit-level moderate"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.6",
    "@angular/common": "^22.2.5",
    "@angular/compiler": "^22.2.5",
    "@angular/core": "^22.2.5",
    "@angular/forms": "^22.2.5",
    "@angular/material": "^22.2.6",
    "@angular/platform-browser": "^22.2.5",
    "@angular/platform-server": "^22.2.5",
    "@angular/router": "^22.2.5",
    "@angular/ssr": "^22.2.6",
    "@supabase/supabase-js": "^2.119.0",
    "dexie": "^4.4.7",
    "echarts": "^6.1.0",
    "express": "^5.1.0",
    "jszip": "^3.10.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.5",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^5.0.1",
    "@types/node": "^22.12.0",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
